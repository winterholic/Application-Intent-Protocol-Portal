---
import Icons from "../components/Icons.astro";
import { DEFAULT_LOCALE, LOCALE_META, LOCALES, localizePath, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import "../styles/site.css";

interface Props {
  locale: Locale;
  /** 언어 중립 경로(예: `/docs/concepts/`). hreflang 대체 링크와 canonical에 쓴다. */
  path: string;
  title: string;
  description: string;
  /** 같은 내용의 Markdown 판 경로. */
  markdown?: string;
  /** 다른 언어판이 없는 페이지(404 등). */
  noAlternates?: boolean;
}
const { locale, path, title, description, markdown, noAlternates = false } = Astro.props;
const abs = (p: string) => new URL(p, Astro.site).href;
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(localizePath(locale, path))} />
    {
      !noAlternates &&
        LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_META[l].hreflang} href={abs(localizePath(l, path))} />)
    }
    {!noAlternates && <link rel="alternate" hreflang="x-default" href={abs(localizePath(DEFAULT_LOCALE, path))} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AIP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(localizePath(locale, path))} />
    <meta property="og:image" content={abs("/brand/intent-runtime-3d.webp")} />
    <meta property="og:locale" content={LOCALE_META[locale].htmlLang.replace("-", "_")} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon-180.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline>try{var t=localStorage.getItem('aip-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/jetbrains-mono@5/index.min.css" />
    <link rel="stylesheet" href="/vendor/aip/tokens.css" />
    <link rel="stylesheet" href="/vendor/aip/typography.css" />
    <link rel="stylesheet" href="/vendor/aip/prose.css" />
    <link rel="stylesheet" href="/vendor/aip/components.css" />
    <script is:inline src="/vendor/aip/aip.js" defer></script>
  </head>
  <body>
    <Icons />
    <a class="aip-skip-link" href="#main">{t(locale).chrome.skip}</a>
    <slot />
  </body>
</html>
