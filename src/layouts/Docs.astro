---
import DocSidebar from "../components/DocSidebar.astro";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
import { DEFAULT_LOCALE, localizePath } from "../i18n/locales";
import { t } from "../i18n/ui";
import { getDocs, htmlPath, markdownPath, type Doc } from "../lib/docs";
import { coreFile, PORTAL_REPO } from "../lib/site";
import Base from "./Base.astro";

interface Props {
  doc: Doc;
}
const { doc } = Astro.props;
const { locale } = doc;
const ui = t(locale);
const { title, description } = doc.entry.data;
const { status, source, checked } = doc.meta;
const docs = await getDocs(locale);
const index = docs.findIndex((d) => d.key === doc.key);
const prev = docs[index - 1];
const next = docs[index + 1];
const headings = doc.rendered.headings;
const editUrl = `${PORTAL_REPO}/edit/main/${doc.entry.filePath}`;
const docsHome = localizePath(locale, "/docs/");
const crumbs = doc.key === "index" ? [] : [ui.nav[doc.group], title];
const neutralPath = `/${doc.route}/`;
const englishPath = `/${doc.route}/`;
---

<Base locale={locale} path={neutralPath} title={`${title} · AIP Docs`} description={description} markdown={markdownPath(doc)}>
  <Header locale={locale} path={neutralPath} product={ui.chrome.docs} current="docs" search full />

  <div class="aip-docs__mobilebar">
    <button class="aip-button aip-button--sm aip-button--ghost" type="button" data-aip-dialog-open="docs-drawer">
      <svg class="aip-icon" aria-hidden="true"><use href="#i-menu" /></svg>
      {ui.chrome.menu}
    </button>
    <nav class="aip-breadcrumb" aria-label={ui.chrome.breadcrumb}>
      <ol>
        <li><a href={docsHome}>{ui.chrome.docs}</a></li>
        {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c}</span> : <span>{c}</span>}</li>)}
      </ol>
    </nav>
  </div>

  <div class="aip-docs">
    <aside class="aip-docs__sidebar"><DocSidebar current={doc} instance="main" /></aside>

    <div class="aip-docs__body">
      <main class="aip-docs__main" id="main" tabindex="-1">
        <div class="aip-docs__head">
          {
            crumbs.length > 0 && (
              <nav class="aip-breadcrumb aip-hide-below-md" aria-label={ui.chrome.breadcrumb}>
                <ol>
                  <li><a href={docsHome}>{ui.chrome.docs}</a></li>
                  {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c}</span> : <span>{c}</span>}</li>)}
                </ol>
              </nav>
            )
          }
          <h1 class="aip-doc-title">{title}</h1>
          <p class="aip-doc-lead aip-text-secondary">{description}</p>
          <div class="aip-docs__meta">
            <span class="aip-badge" data-doc-status={status}>{status}</span>
            {checked && <span>{ui.chrome.checked} {checked.toISOString().slice(0, 10)}</span>}
            {
              locale !== DEFAULT_LOCALE && doc.translation?.upToDate && (
                <span>
                  {ui.chrome.translationNote} <a class="aip-link" href={englishPath} hreflang="en" lang="en">{ui.chrome.readEnglish}</a>
                </span>
              )
            }
            <a class="aip-link" href={markdownPath(doc)}>{ui.chrome.viewMarkdown}</a>
            <a class="aip-link" href={editUrl}>{ui.chrome.editPage}</a>
          </div>
          {
            source.length > 0 && (
              <p class="aip-caption aip-text-tertiary site-doc-source">
                {ui.chrome.source}:{" "}
                {source.map((s, i) => (
                  <>
                    {i > 0 && " · "}
                    <a class="aip-link" href={coreFile(s)} title={s}>{s.split("/").pop()}</a>
                  </>
                ))}
              </p>
            )
          }
        </div>

        {
          locale !== DEFAULT_LOCALE && !doc.translation?.upToDate && (
            <aside class="aip-callout aip-callout--warning site-translation-note" role="note">
              <div class="aip-callout__body">
                <p>
                  {ui.chrome.translationBehind}{" "}
                  <a class="aip-link" href={englishPath} hreflang="en" lang="en">{ui.chrome.readEnglish}</a>
                </p>
              </div>
            </aside>
          )
        }

        {
          headings.length > 0 && (
            <details class="aip-toc-disclosure">
              <summary>{ui.chrome.onThisPage}</summary>
              <nav class="aip-toc" aria-label={ui.chrome.onThisPageCollapsed}>
                <ol>
                  {headings.map((h) => (
                    <li><a class="aip-toc__link" href={`#${h.id}`} data-level={h.depth === 3 ? "3" : undefined}>{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            </details>
          )
        }

        <article class="aip-doc" set:html={doc.rendered.html} />

        {
          (prev || next) && (
            <nav class="aip-pager" aria-label={ui.chrome.pager}>
              {prev && (
                <a class="aip-pager__link" href={htmlPath(prev)}>
                  <span class="aip-pager__dir">{ui.chrome.previous}</span>
                  <span class="aip-pager__title">{prev.entry.data.title}</span>
                </a>
              )}
              {next && (
                <a class="aip-pager__link aip-pager__link--next" href={htmlPath(next)}>
                  <span class="aip-pager__dir">{ui.chrome.next}</span>
                  <span class="aip-pager__title">{next.entry.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </main>

      {
        headings.length > 0 && (
          <aside class="aip-docs__toc">
            <nav class="aip-toc" aria-labelledby="toc-title">
              <p class="aip-toc__title" id="toc-title">{ui.chrome.onThisPage}</p>
              <ol>
                {headings.map((h) => (
                  <li><a class="aip-toc__link" href={`#${h.id}`} data-level={h.depth === 3 ? "3" : undefined}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </div>

  <dialog class="aip-drawer" id="docs-drawer" aria-label={ui.chrome.documentation}>
    <div class="aip-drawer__header">
      <span class="aip-label">{ui.chrome.documentation}</span>
      <button class="aip-icon-button aip-icon-button--sm" type="button" data-aip-dialog-close aria-label={ui.chrome.closeNav}>
        <svg class="aip-icon" aria-hidden="true"><use href="#i-x" /></svg>
      </button>
    </div>
    <div class="aip-drawer__body"><DocSidebar current={doc} instance="drawer" /></div>
  </dialog>

  <Search locale={locale} />
</Base>
