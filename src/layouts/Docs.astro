---
import DocSidebar from "../components/DocSidebar.astro";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
import { getDocs, htmlPath, markdownPath, type Doc } from "../lib/docs";
import { coreFile, PORTAL_REPO } from "../lib/site";
import Base from "./Base.astro";

interface Props {
  doc: Doc;
}
const { doc } = Astro.props;
const { title, description, status, source, checked } = doc.entry.data;
const docs = await getDocs();
const index = docs.indexOf(doc);
const prev = docs[index - 1];
const next = docs[index + 1];
const headings = doc.rendered.headings;
const editUrl = `${PORTAL_REPO}/edit/main/src/content/docs/${doc.entry.filePath?.replace(/^src\/content\/docs\//, "")}`;
const crumbs = doc.route === "docs" ? [] : [doc.group, title];
---

<Base title={`${title} · AIP Docs`} description={description} markdown={markdownPath(doc)}>
  <Header product="Docs" current="docs" search full />

  <div class="aip-docs__mobilebar">
    <button class="aip-button aip-button--sm aip-button--ghost" type="button" data-aip-dialog-open="docs-drawer">
      <svg class="aip-icon" aria-hidden="true"><use href="#i-menu" /></svg> Menu
    </button>
    <nav class="aip-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/docs/">Docs</a></li>
        {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c}</span> : <span>{c}</span>}</li>)}
      </ol>
    </nav>
  </div>

  <div class="aip-docs">
    <aside class="aip-docs__sidebar"><DocSidebar current={doc} instance="main" /></aside>

    <div class="aip-docs__body">
      <main class="aip-docs__main" id="main" tabindex="-1">
        <div class="aip-docs__head">
          <nav class="aip-breadcrumb aip-hide-below-md" aria-label="Breadcrumb">
            <ol>
              <li>{crumbs.length ? <a href="/docs/">Docs</a> : <span aria-current="page">Docs</span>}</li>
              {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c}</span> : <span>{c}</span>}</li>)}
            </ol>
          </nav>
          <h1 class="aip-doc-title">{title}</h1>
          <p class="aip-doc-lead aip-text-secondary">{description}</p>
          <div class="aip-docs__meta">
            <span class="aip-badge" data-doc-status={status}>{status}</span>
            {checked && <span>Checked against AIP Core {checked.toISOString().slice(0, 10)}</span>}
            {
              source.length > 0 && (
                <span>
                  Source:{" "}
                  {source.map((s, i) => (
                    <>
                      {i > 0 && ", "}
                      <a class="aip-link" href={coreFile(s)}>{s}</a>
                    </>
                  ))}
                </span>
              )
            }
            <a class="aip-link" href={editUrl}>Edit this page</a>
            <a class="aip-link" href={markdownPath(doc)}>View as Markdown</a>
          </div>
        </div>

        {
          headings.length > 0 && (
            <details class="aip-toc-disclosure">
              <summary>On this page</summary>
              <nav class="aip-toc" aria-label="On this page (collapsed)">
                <ol>
                  {headings.map((h) => (
                    <li><a class="aip-toc__link" href={`#${h.id}`} data-level={h.depth === 3 ? "3" : undefined}>{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            </details>
          )
        }

        <article class="aip-doc" set:html={doc.rendered.html} />

        {
          (prev || next) && (
            <nav class="aip-pager" aria-label="Previous and next page">
              {prev && (
                <a class="aip-pager__link" href={htmlPath(prev)}>
                  <span class="aip-pager__dir">← Previous</span>
                  <span class="aip-pager__title">{prev.entry.data.title}</span>
                </a>
              )}
              {next && (
                <a class="aip-pager__link aip-pager__link--next" href={htmlPath(next)}>
                  <span class="aip-pager__dir">Next →</span>
                  <span class="aip-pager__title">{next.entry.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </main>

      {
        headings.length > 0 && (
          <aside class="aip-docs__toc">
            <nav class="aip-toc" aria-labelledby="toc-title">
              <p class="aip-toc__title" id="toc-title">On this page</p>
              <ol>
                {headings.map((h) => (
                  <li><a class="aip-toc__link" href={`#${h.id}`} data-level={h.depth === 3 ? "3" : undefined}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </div>

  <dialog class="aip-drawer" id="docs-drawer" aria-label="Documentation navigation">
    <div class="aip-drawer__header">
      <span class="aip-label">Documentation</span>
      <button class="aip-icon-button aip-icon-button--sm" type="button" data-aip-dialog-close aria-label="Close navigation">
        <svg class="aip-icon" aria-hidden="true"><use href="#i-x" /></svg>
      </button>
    </div>
    <div class="aip-drawer__body"><DocSidebar current={doc} instance="drawer" /></div>
  </dialog>

  <Search />
</Base>
