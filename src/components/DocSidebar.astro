---
import { t } from "../i18n/ui";
import { getDocs, htmlPath, type Doc } from "../lib/docs";

interface Props {
  current: Doc;
  /** 같은 사이드바가 데스크톱 열과 모바일 드로어에 두 번 들어가므로 id를 구분한다. */
  instance: "main" | "drawer";
}
const { current, instance } = Astro.props;
const ui = t(current.locale);
const docs = await getDocs(current.locale);
const groups = [...new Set(docs.map((d) => d.group))];
---

<nav class="aip-sidebar" aria-label={ui.chrome.documentation}>
  {
    groups.map((group) => (
      <div>
        <p class="aip-sidebar__title" id={`sb-${group}-${instance}`}>{ui.nav[group]}</p>
        <ul aria-labelledby={`sb-${group}-${instance}`}>
          {docs
            .filter((d) => d.group === group)
            .map((d) => (
              <li>
                <a class="aip-sidebar__link" href={htmlPath(d)} aria-current={d.key === current.key ? "page" : undefined}>
                  {d.entry.data.sidebarLabel ?? d.entry.data.title}
                  {d.meta.status === "stub" && <span class="aip-badge">{ui.chrome.stub}</span>}
                </a>
              </li>
            ))}
        </ul>
      </div>
    ))
  }
</nav>
