---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { getDocs, htmlPath } from "../lib/docs";

// 빌드 시점에 현재 언어 문서의 제목과 h2·h3을 결과 목록으로 굽는다. aip.js가 텍스트 포함으로 거른다.
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const docs = await getDocs(locale);
const groups = [...new Set(docs.map((d) => d.group))];
const pathLabel = (route: string) => route.split("/").join(" / ");
---

<dialog class="aip-search" aria-label={ui.chrome.searchLabel}>
  <div class="aip-search__field">
    <svg class="aip-icon" aria-hidden="true"><use href="#i-search" /></svg>
    <input class="aip-search__input" type="search" placeholder={ui.chrome.searchDocs} aria-label={ui.chrome.searchDocs} autocomplete="off" spellcheck="false" />
    <kbd>esc</kbd>
  </div>
  <ul class="aip-search__results">
    {
      groups.map((group) => (
        <>
          <li class="aip-search__group" role="presentation">{ui.nav[group]}</li>
          {docs
            .filter((d) => d.group === group)
            .flatMap((d) => [
              { href: htmlPath(d), title: d.entry.data.title, path: pathLabel(d.route) },
              ...d.rendered.headings.map((h) => ({
                href: `${htmlPath(d)}#${h.id}`,
                title: `${h.text} · ${d.entry.data.title}`,
                path: `${pathLabel(d.route)} #${h.id}`,
              })),
            ])
            .map((r) => (
              <li>
                <a class="aip-search__result" href={r.href}>
                  <span class="aip-search__title">{r.title}</span>
                  <span class="aip-search__path">{r.path}</span>
                </a>
              </li>
            ))}
        </>
      ))
    }
  </ul>
  <p class="aip-search__empty" hidden>{ui.chrome.noResults} “<span data-aip-search-query></span>”</p>
  <div class="aip-search__footer">
    <span><kbd>↑</kbd><kbd>↓</kbd> {ui.chrome.move}</span><span><kbd>↵</kbd> {ui.chrome.open}</span><span><kbd>esc</kbd> {ui.chrome.close}</span>
  </div>
</dialog>
