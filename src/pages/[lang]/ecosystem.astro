---
import { TRANSLATED_LOCALES, type Locale } from "../../i18n/locales";
import EcosystemPage from "../../views/EcosystemPage.astro";

export const getStaticPaths = () => TRANSLATED_LOCALES.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
---

<EcosystemPage locale={lang} />
