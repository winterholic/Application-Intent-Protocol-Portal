---
import Site from "../layouts/Site.astro";

// NOTE: 공개 URL이 없는 도구는 링크를 만들지 않는다.
const projects = [
  {
    name: "AIP Core",
    description: "AIP Specification과 Rust 엔진. 모든 AIP 규칙의 정본.",
    href: "https://github.com/winterholic/Application-Intent-Protocol",
    state: "설계·검증 중",
  },
  {
    name: "MakeAIP",
    description: "AIP 프로젝트를 시작하는 공식 Project Generator.",
    href: "https://github.com/winterholic/Application-Intent-Protocol-Starter",
    state: "초기 세팅",
  },
  { name: "Playground", description: "향후 제공할 공식 도구.", state: "계획" },
];
---

<Site title="Ecosystem — AIP" description="AIP 관련 공식 프로젝트와 도구">
  <h1>Ecosystem</h1>
  <p class="lede">AIP 관련 공식 프로젝트와 도구.</p>
  <ul class="cards">
    {
      projects.map((p) => (
        <li>
          <strong>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</strong>
          <span class="tag">{p.state}</span>
          <p>{p.description}</p>
        </li>
      ))
    }
  </ul>
</Site>
