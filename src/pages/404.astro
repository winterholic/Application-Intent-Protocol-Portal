---
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Not found · AIP" description="페이지를 찾을 수 없다.">
  <Header />
  <main id="main" tabindex="-1">
    <div class="aip-container aip-container--sm aip-stack aip-gap-6 site-error">
      <p class="aip-eyebrow aip-text-brand">404</p>
      <h1 class="aip-heading-1">페이지가 옮겨졌거나 없는 주소다</h1>
      <p class="aip-cluster aip-gap-4"><a class="aip-link" href="/">Home</a><a class="aip-link" href="/docs/">Docs</a><a class="aip-link" href="/llms.txt">llms.txt</a></p>
    </div>
  </main>
</Base>
