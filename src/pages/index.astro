---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Base from "../layouts/Base.astro";
import { CORE_REPO } from "../lib/site";

// 문구는 AIP Core의 README.md·docs/PRINCIPLES.md에서 확정된 내용만 쓴다.
const principles = [
  {
    eyebrow: "Freedom to ask",
    title: "호출자는 표현한다",
    body: "화면에 필요한 데이터와 동작을 호출자가 표현한다. 기능마다 백엔드 API를 새로 만들지 않는다.",
  },
  {
    eyebrow: "Authority to run",
    title: "서버가 결정한다",
    body: "권한과 실행은 서버가 최종 결정한다. 인증·인가·비즈니스 규칙·데이터 무결성은 서버에 남는다.",
  },
  {
    eyebrow: "Readable by both",
    title: "사람과 AI가 같이 읽는다",
    body: "표현을 정형화해 근거 없는 구현 선택을 줄인다. 사람이 이해하고 검증할 수 있어야 한다.",
  },
];
---

<Base title="AIP · Application Intent Protocol" description="프론트엔드가 필요한 데이터와 동작을 표현하면, 서버가 정책과 계약에 따라 실행한다.">
  <Header />
  <main id="main" tabindex="-1">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="aip-container aip-container--lg home-hero__inner">
        <div class="home-hero__copy">
          <p class="aip-eyebrow aip-text-brand">Application Intent Protocol · open source</p>
          <h1 class="aip-display-xl" id="hero-title">화면에 필요한 것을 <mark class="home-mark">표현</mark>하면, 서버가 실행한다.</h1>
          <p class="aip-lead aip-text-secondary">
            기능마다 endpoint를 새로 만들지 않는다. 호출자가 필요한 데이터와 동작을 표현하면, AIP Runtime이 서버가 정한 정책과 계약 안에서 실행한다.
          </p>
          <div class="aip-cluster aip-gap-3">
            <a class="aip-button aip-button--primary aip-button--lg" href="/docs/">Read the docs</a>
            <a class="aip-button aip-button--lg" href={CORE_REPO}>
              <svg class="aip-icon" aria-hidden="true"><use href="#i-github" /></svg>View on GitHub
            </a>
          </div>
        </div>
        <figure class="aip-artwork">
          <img src="/brand/intent-runtime-3d.webp" alt="" width="1672" height="941" fetchpriority="high" />
          <figcaption>Intent → Runtime → Result · conceptual brand illustration.</figcaption>
        </figure>
      </div>
    </section>

    <section class="aip-section aip-section--subtle" id="principles" aria-labelledby="pr-title">
      <div class="aip-container aip-container--lg aip-stack aip-gap-12">
        <div class="site-head">
          <p class="aip-eyebrow aip-text-brand">01 — Principles</p>
          <h2 class="aip-display-md" id="pr-title">요청의 자유와 실행 권한을 분리한다.</h2>
        </div>
        <div class="aip-grid aip-grid--3">
          {
            principles.map((p) => (
              <div class="aip-card aip-card--lg">
                <p class="aip-card__eyebrow">{p.eyebrow}</p>
                <p class="aip-card__title">{p.title}</p>
                <p class="aip-card__body">{p.body}</p>
              </div>
            ))
          }
        </div>
        <p><a class="aip-link" href="/docs/concepts/">일곱 가지 원칙 전체 보기</a></p>
      </div>
    </section>

    <section class="aip-section" aria-labelledby="arch-title">
      <div class="aip-container aip-container--lg aip-stack aip-gap-8">
        <div class="site-head">
          <p class="aip-eyebrow aip-text-brand">02 — Model</p>
          <h2 class="aip-display-md" id="arch-title">표현은 호출자가, 결정은 서버가</h2>
          <p class="aip-lead aip-text-secondary">노랑은 호출자가 표현한 것, 파랑은 AIP, 탱저린은 서버가 넘지 못하게 하는 경계다.</p>
        </div>
        <figure class="aip-diagram">
          <div class="aip-diagram__canvas">
            <ol class="aip-flow" aria-label="Request path">
              <li class="aip-node" data-role="frontend"><span class="aip-node__kind">frontend</span>화면</li>
              <li class="aip-node" data-role="intent"><span class="aip-node__kind">intent</span>필요한 데이터·동작</li>
              <li class="aip-node" data-role="permission" data-edge="emphasis"><span class="aip-node__kind">permission</span>서버 정책·계약</li>
              <li class="aip-node" data-role="execution" data-edge="allow"><span class="aip-node__kind">execution</span>AIP Runtime</li>
              <li class="aip-node" data-role="data"><span class="aip-node__kind">data</span>데이터</li>
            </ol>
          </div>
          <figcaption class="aip-diagram__caption">
            호출자가 표현한 요청은 서버의 정책과 계약을 통과한 뒤에만 실행된다. 요청 형식과 정책 작성 방식은 아직 설계 중이다.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="aip-section aip-section--subtle" aria-labelledby="status-title">
      <div class="aip-container aip-container--lg aip-stack aip-gap-8">
        <div class="site-head">
          <p class="aip-eyebrow aip-text-brand">03 — Status</p>
          <h2 class="aip-display-md" id="status-title">설계와 검증이 진행 중이다</h2>
          <p class="aip-lead aip-text-secondary">이 사이트는 AIP Core에서 확정된 내용만 다룬다. 정해지지 않은 것은 정해지지 않았다고 쓴다.</p>
        </div>
        <div class="site-status">
          <div class="aip-card">
            <p class="aip-card__title">확정된 기준</p>
            <ul class="aip-body-md">
              <li>호출자가 표현하고 서버가 최종 결정하는 호출 모델</li>
              <li>Rust 핵심 엔진과 JS/TS·Python 생태계</li>
              <li>AIP 서버와 공식 프론트 SDK를 함께 제공</li>
            </ul>
          </div>
          <div class="aip-card">
            <p class="aip-card__title">아직 정해지지 않은 것</p>
            <ul class="aip-body-md">
              <li>정의 작성 형식과 구체 문법</li>
              <li>첫 출시의 언어·프론트 통합 범위</li>
              <li>지원 데이터베이스 범위</li>
            </ul>
          </div>
        </div>
        <p><a class="aip-link" href="/docs/status/">현재 상태 전체 보기</a></p>
      </div>
    </section>

    <section class="home-cta" aria-labelledby="cta-title">
      <div class="aip-container aip-container--lg home-cta__inner">
        <div class="aip-stack aip-gap-3">
          <h2 class="aip-display-md" id="cta-title">설계 과정을 함께 보세요.</h2>
          <p class="aip-body-lg">AIP는 오픈소스로 설계되고 있다. 원칙, 결정 기록, 검증 결과가 모두 저장소에 있다.</p>
        </div>
        <a class="aip-button aip-button--lg home-cta__button" href={CORE_REPO}>
          Open AIP Core <svg class="aip-icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
